deflower include.prg
; the included lines are weak, so the lines below win wherever they overlap
include machine.flo
$c000 code start
$c020 addr[2] vectors
; overrides the I/O piece's background_color
$d021 virtual byte screen_color
; overrides the zero page piece's free bytes
$fb virtual word pointer
; overlaps the system piece's tape_buffer
$033c virtual byte[4] my_buffer
