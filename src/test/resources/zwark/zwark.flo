    $ae byte[3] unlsn
    $b1 byte[3] listen
    $b4 byte[3] talk
    $b7 byte[3] readst
    $ba byte[3] setlfs
    $bd byte[3] setnam
    $c0 byte[3] open
    $c3 byte[3] close
    $c6 byte[3] chkin
    $c9 byte[3] chkout
    $cc byte[3] clrchn
    $cf byte[3] chrin
    $d2 byte[3] chrout
    $d5 byte[3] load
    $d8 byte[3] save
    $db byte[3] settim
    $de byte[3] rdtim
    $e1 byte[3] stop
