; ---- music ----
; The music player plays up to three voices, each with its own copy of the player code
; (voice_1_play at $c100, voice_2_play at $c200, voice_3_play at $c300) and its own two
; parallel streams: a note stream and, $800 further, a parameter stream, read at the same index.
; Voice 1 reads $e000/$e800 (under the KERNAL ROM, copied there from $9000/$9800), voice 2
; $a000/$a800 (empty, the game never plays voice 2), voice 3 $b000/$b800.
; A note byte with its parameter means:
; - $00: return from a call, or stop the voice when not in one;
; - $ff with 0: call: the next pair holds the position (note stream) and page (parameter stream)
;   to go to; the return position goes to the voice's call slot (one level only);
; - $ff with n: repeat: jump to the next pair's position n times, then go on after it;
; - $7f with d: a rest of 2*d ticks;
; - else a note number with d: plays the note (note_freq_hi/lo) for 2*d ticks, and releases the
;   gate one tick early unless d has bit 7 set.
; A tick is voice_speeds+1 IRQs. The game plays one tune at position 0 on voices 1 and 3, with
; triangle waves on the title (play_title_music) and pulse waves in the game (play_game_music).
; a copy of the music player, and the loader at $7800
$7000-$9000 byte
; copied to $e000/$e800 by copy_music_data
$9000-$9252 byte voice_1_notes_copy
$9252-$9800 virtual byte unused_9252
$9800-$9a52 byte voice_1_parameters_copy
$9a52-$a000 virtual byte unused_9a52
$a000-$a7e0 virtual byte voice_2_notes
$a7e0 virtual byte voice_2_in_call
$a7e1 virtual byte voice_2_return_page
$a7e2 virtual byte voice_2_return_position
$a7e3-$a800 virtual byte
$a800 virtual byte[$800] voice_2_parameters
$b000-$b217 byte voice_3_notes
$b217-$b7e0 virtual byte unused_b217
$b7e0 virtual byte voice_3_in_call
$b7e1 virtual byte voice_3_return_page
$b7e2 virtual byte voice_3_return_position
$b7e3-$b800 virtual byte
$b800-$ba17 byte voice_3_parameters
$ba17-$bfe9 virtual byte unused_ba17
; unpack_music's parameters, copied from unpack_parameters
$bfe9 virtual byte[4] unpack_block
$bfed-$c000 virtual byte
; the note frequencies, high and low bytes, by note number
$c000 byte[80] note_freq_hi
$c050 byte[80] note_freq_lo
; copied to the SID ($d401-$d418) by init_sid
$c0a0 byte[25] sid_registers
$c0b9-$c0bc byte
; IRQs per tick, minus one, per voice
$c0bc byte[3] voice_speeds
$c0bf byte
$c0c0 byte voice_1_duration
$c0c1 byte voice_1_speed_countdown
$c0c2 byte voice_1_repeat_count
$c0c3 byte voice_1_position
; added to the streams' first page
$c0c4 byte voice_1_page
$c0c5 byte voice_2_duration
$c0c6 byte voice_2_speed_countdown
$c0c7 byte voice_2_repeat_count
$c0c8 byte voice_2_position
$c0c9 byte voice_2_page
$c0ca byte voice_3_duration
$c0cb byte voice_3_speed_countdown
$c0cc byte voice_3_repeat_count
$c0cd byte voice_3_position
$c0ce byte voice_3_page
; bit 0-2: voice 1-3 plays
$c0cf byte voices_playing
$c0d0-$c100 byte
; per IRQ: counts the speed down, then the duration, then reads the next note
$c100 voice_1_play
$c109 voice_1_tick
$c1ba byte
$c1bb voice_1_set_page
$c1ca voice_1_next
$c1d8 voice_1_read_note
$c1df voice_1_read_parameter
; also how a voice stops when its stream ends
$c1e6 voice_1_silence
; voice 2's copy of the code; it stores its page in voice_1_page after a call, a bug that
; doesn't show because voice 2 is never played
$c200 voice_2_play
$c209 voice_2_tick
$c2ba byte
$c2bb voice_2_set_page
$c2ca voice_2_next
$c2d8 voice_2_read_note
$c2df voice_2_read_parameter
$c2e6 voice_2_silence
