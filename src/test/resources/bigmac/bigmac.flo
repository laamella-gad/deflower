; Big Mac - the Mad Maintenance Man (Mastertronic), from a VICE snapshot of its title screen.
;
; The game: the player walks, climbs and jumps through 18 single-screen levels. Each level has
; up to 10 numbered switches (levers, chars $59-$5c, numbered by their colour). Every switch
; drives machinery: conveyors, bridges, force beams, lifts, pistons and sprite enemies, which run
; while their switch is on. Turning all switches off and touching the exit char $5e "closes" the
; level. Air and bonus count down; air at 0, a deadly char or a sprite collision costs a man.
; One or two players take turns; the top 5 scores are saved to disk as "HIGHSCOREBM".
;
; Structure:
; - title_screen shows the title, then a demo of levels 1-9, then the highscores, round and round.
;   H shows the highscores, fire or space goes to the 1/2 players, joystick/keyboard choice.
; - start_level draws the level from the level stream (draw_level, setup_enemies), then
;   main_loop runs, once per pass: music keys, player, hotkeys and objects, enemies, the
;   charset animation and the air/bonus count, until sprite 0 (the player) collides.
; - The screen is 40x25 multicolor characters, the bottom row is the status line. The score,
;   men, air and bonus are kept as screen code digits in the status line itself.
; - The music player at $c100 runs in the IRQ at $c543.
;
; bigmac.vsf: VICE snapshot of a C64SC
; $01 = $35: BASIC out, KERNAL out, I/O in
; CPU: PC $c54d A $02 X $ec Y $00 SP $eb P $25
; IRQ $0314 -> $c543 (RAM)
; VIC bank 0 ($0000-$3fff), multicolor text, screen $0400, charset $2000
; sprites on, pointers at $07f8: 0 $2d40
; interrupt sources: CIA1 timer A (IRQ), IRQs masked by the I flag
deflower bigmac.vsf

; ---- zero page ----
; the current level, 1-18
$02 virtual byte level
; 1: keyboard (W A X D and shift), 0: joystick in port 2
$03 virtual byte keyboard_control
; the joystick bits read by read_controls: direction, and fire
$04 virtual byte direction
$05 virtual byte fire
; 1 while the player jumps or falls
$06 virtual byte jumping
; the player sprite's position: x (9 bits) and y
$07 virtual byte player_x
$08 virtual byte player_x_high
$09 virtual byte player_y
$0a virtual byte player_frame
; player_y & 7: 7 when standing on a character row
$0d virtual byte player_y_fine
; the position before this move, restored when the move is blocked
$0e virtual byte previous_x
$0f virtual byte previous_x_high
$10 virtual byte previous_y
$11 virtual byte previous_frame
$12 virtual byte jump_timer
$13 virtual byte jump_phase
; update_player moves the player once every move_delay passes
$14 virtual byte move_countdown
$15 virtual byte move_delay
; the number of object slots used while drawing the level
$56 virtual byte object_count
$57 virtual byte temp_1
$58 virtual byte temp_2
; the colour RAM address of screen_pointer, by color_pointer
$59 virtual byte color_pointer_lo
$5a virtual byte color_pointer_hi
$fb virtual byte screen_pointer_lo
$fc virtual byte screen_pointer_hi
; where the level stream is read, by next_level_byte
$fd virtual byte level_pointer_lo
$fe virtual byte level_pointer_hi

; ---- system ----
; the cheat bits, cleared for each cheat, from the loader's menu; $ff is no cheats
$0200 virtual byte cheat_bits
; the IRQ vector
$0314 addr irq_vector
; variables in the tape buffer
; 1: player 1 plays, 3: both play; a player's bit is cleared at game over
$033c virtual byte players_left
$033d virtual byte current_player
$033e-$0340 virtual byte
; counts down the passes between charset animation steps
$0340 virtual byte animation_countdown
; the level each player is on, indexed by the player number
$0341 virtual byte[2] player_levels
$0343-$0379 virtual byte
; counts down the passes between air ticks
$0379 virtual byte air_countdown
$037a-$0384 virtual byte
; each player's status line, saved while the other one plays
$0384 virtual screencode[40] status_line_1
$03ac virtual screencode[40] status_line_2

; ---- game state ----
; on (1) or off (0), one per switch number
$0800-$080c byte[12] switches
; Object slots, for the machinery drawn by the level stream. The fields mean per type:
; type 1 conveyor: switch, delay countdown, delay, screen pointer at object_c/object_d,
;   direction, belt position, length
; type 2 bridge: switch, length, screen pointer at object_b/object_c
; type 3 force beam: switch, length, screen pointer at object_b/object_c
; type 4 force column: switch, height, screen pointer at object_b/object_c
; type 5 lift: switch, width, screen pointer at object_b/object_c, delay at object_c and
;   object_d, position at object_f
; type 9 piston: switch and its own fields
$080c byte[40] object_type
$0834 byte[40] object_switch
$085c byte[40] object_a
$0884 byte[40] object_b
$08ac byte[40] object_c
$08d4 byte[40] object_d
$08fc byte[40] object_e
$0924 byte[40] object_f
$094c byte[40] object_g
$0974-$097e virtual byte untouched_0974
; Enemy slots, for the sprites after the level's $fe. Only 7 are updated. The fields mean per type:
; type 1 turret (two sprites, the gun and its bullet): switch, frame delay, bullet flying,
;   bullet direction, bullet delay
; type 2 crusher: switch, frame delay, opening or closing
; type 3 hopper: switch, delay, hopping, direction, steps per turn, step count, steps per hop,
;   hop count, hop direction, hop height
; type 5 ball: switch, delay, visible, x direction, y direction
; type 7 dropper: switch, delay, distance, moved, falling
; others (4 walks with animation): switch, delay, delay reload, direction, steps per turn, step count
$097e byte[10] enemy_type
$0988 byte[10] enemy_switch
$0992 byte[10] enemy_timer
$099c byte[10] enemy_d
$09a6 byte[10] enemy_e
$09b0 byte[10] enemy_f
$09ba byte[10] enemy_g
$09c4 byte[10] enemy_h
$09ce byte[10] enemy_i
$09d8 byte[10] enemy_j
$09e2 byte[10] enemy_k
$09ec byte[10] enemy_l
$09f6-$0a00 virtual byte untouched_09f6

; ---- options, highscore saving and hotkeys ----
; patches the game by cheat_bits, cleared bits switch a cheat on:
; bit 0: men don't run out, bit 1: bonus doesn't count down, bit 2: air doesn't run out,
; bit 3: deadly chars and sprites don't kill, bit 4: C= skips a level, bit 5: B toggles all switches
$0a00 code apply_options
; saves the highscore table (part of highscore_screen) with the KERNAL, after a new entry,
; unless cheats were on, then back to the title
$0a72 save_highscores
$0aed enter_highscore_name
$0b15 byte saved_rank_digit
; per pass: the cheat keys, R to restart the level, then the objects
$0b16 check_keys
$0b2d check_restart_key
$0b6c check_switch_cheat_key
$0bd5 check_level_skip_key
; leftover of a copy of the KERNAL's reset code, partly overwritten
$0c25-$0eb0 byte kernal_copy
$0eb0 first_level_byte
$0eb9 find_level_and_read
$0ec0 screencode[6] closed_text
$0ec6 screencode[18] game_over_text
$0ed8 screencode[20] players_text
$0eec screencode[20] control_text
$0f00-$0f5e virtual byte untouched_0f00
; read by nothing
$0f5e-$0f9d byte
$0f9d-$0fff virtual byte untouched_0f9d
$0fff-$1026 byte
$1026 screencode[18] player_text
; copied to both players' status lines at the start of a game
$1038 screencode[40] status_line_template
; the saved screens, colour RAM (high nibbles undefined) and characters
$1060 byte[1000] highscore_colors
$1448 byte[1000] highscore_screen
$1830 byte[1000] title_colors
$1c18 byte[1000] title_screen

; ---- graphics, level drawing and objects ----
; multicolor; chars $20-$6f are the playfield, see update_player for what they do
$2000 byte[8*130] charset
$2410 next_screen_cell
$241b next_level_byte
$2428 color_pointer
$2434 next_screen_row
$247f previous_screen_row
$2442 clear_screen
$2458 object_screen_pointer
; points level_pointer at level `level`: the levels follow each other, each ends with $ff
$2465 find_level
; switches on every switch an object uses
$248d switch_on_objects
; draws the level: the border char and colour, then the level stream from screen $0429:
; $fe ends it and starts the enemy list, 0 n skips n cells, 1 a conveyor, 2 a bridge,
; 3 a force beam, 4 a force column, 5 a lift, 6 an escalator, 7 a rope, 9 a piston,
; 10 a ladder, else a run of (char, colour, count)
$24a8 draw_level
$2511 next_level_command
$2516 level_command
$2570 update_objects
$25be draw_run
$25e5 skip_cells
$25fa draw_ladder
$2635 draw_rope
$2665 add_conveyor
