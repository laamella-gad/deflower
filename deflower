#!/bin/sh
# Runs deflower, e.g. ./deflower --verify tests/resources/squirm/squirm.flo
# Builds bin/deflower first when it is missing or a source is newer.
dir=$(cd "$(dirname "$0")" && pwd)
bin="$dir/bin/deflower"
if [ ! -x "$bin" ] || [ -n "$(find "$dir/src" "$dir/mpu6502/src" "$dir/deflower.nimble" "$dir/config.nims" -newer "$bin" -type f | head -n 1)" ]; then
    nim c -d:release --hints:off --warnings:off -o:"$bin" "$dir/src/deflower.nim" >&2 || exit 2
fi
exec "$bin" "$@"
